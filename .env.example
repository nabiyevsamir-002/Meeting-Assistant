# ==============================================================
# AI Meeting Assistant — mühit dəyişənləri nümunəsi
# Bu faylı .env adı ilə kopyalayın: cp .env.example .env
# HEÇ BİR açar olmadan da sistem tam işləyir (mock rejimi).
# Real açar əlavə etdikcə uyğun provider "canlı" rejimə keçir.
# Hər açarın haradan alınacağı SETUP.md-də yazılıb.
# ==============================================================

# --- Ümumi tətbiq parametrləri ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Autentifikasiya (JWT) ---
# AUTH_ENABLED=true olduqda bütün /api endpointləri Bearer token tələb edir
AUTH_ENABLED=false
# Daxili servislər (n8n) üçün API açarı (istehsalda: openssl rand -hex 24)
INTERNAL_API_KEY=
# Minimum 32 bayt olmalıdır (HS256 tövsiyəsi); istehsalda: openssl rand -hex 32
JWT_SECRET=dev-secret-mutleq-deyisin-minimum-32-bayt-olsun
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
DEV_USERNAME=admin
DEV_PASSWORD=admin123

# --- LLM provayderi: mock | claude | openai ---
# Bir dəyişənlə Claude <-> OpenAI arasında keçid
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- STT (səs -> mətn) provayderi: mock | elevenlabs | whisper ---
STT_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
WHISPER_MODEL=whisper-1

# --- TTS (mətn -> səs), istəyə bağlı: mock | elevenlabs | openai ---
TTS_ENABLED=false
TTS_PROVIDER=mock
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- Embedding provayderi: mock | openai ---
# Qeyd: Claude API embedding vermir, ona görə real embedding üçün OpenAI istifadə olunur
EMBEDDING_PROVIDER=mock
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# mock və openai (dimensions parametri ilə) eyni ölçüdən istifadə edir
EMBEDDING_DIM=256

# --- Vektor bazası: auto | qdrant | memory ---
# auto: Qdrant əlçatandırsa onu, yoxdursa in-memory mock-u istifadə edir
VECTOR_BACKEND=auto
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CONTEXT=meeting_context
QDRANT_COLLECTION_EPISODES=meeting_episodes

# --- Uzunmüddətli yaddaş: mock | mem0 ---
# mem0 real rejimdə OPENAI_API_KEY + Qdrant tələb edir
LONGTERM_PROVIDER=mock

# --- Google Calendar (OAuth 2.0): mock | google ---
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Xülasə kartı (htmlcsstoimage.com): mock | hcti ---
CARD_PROVIDER=mock
HCTI_USER_ID=
HCTI_API_KEY=

# --- Çatdırılma (n8n webhook -> email/Telegram): mock | n8n ---
DELIVERY_PROVIDER=mock
N8N_DELIVERY_WEBHOOK_URL=http://localhost:5678/webhook/meeting-delivery

# --- Yaddaş / verilənlər bazası ---
SQLITE_PATH=data/app.db
DATA_DIR=data

# --- n8n workflow dəyişənləri (docker compose n8n-ə ötürür) ---
# Çatdırılma workflow-unun email/Telegram parametrləri
DELIVERY_FROM_EMAIL=
DELIVERY_TO_EMAIL=
TELEGRAM_CHAT_ID=
# Scraping workflow-unda şəkil OCR üçün (pulsuz: ocr.space/ocrapi)
OCR_SPACE_API_KEY=

# --- Planlayıcı (APScheduler) ---
SCHEDULER_ENABLED=true
CALENDAR_POLL_MINUTES=5
CALENDAR_LOOKAHEAD_MINUTES=30

# --- Pipeline parametrləri ---
QUICK_SUMMARY_EVERY=3
AGENT_MAX_ITERATIONS=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SEARCH_TOP_K=4
LANGUAGE=az
